#!/bin/bash
# arch2ram-launch SYSTEM ROM — central launcher dispatch
#
# This is what every EmulationStation system <command> calls. Inspired
# by Batocera's emulatorlauncher.py (697 lines) but radically simpler:
# instead of 111 per-emulator config-generators, we have ~20 cases that
# map a SYSTEM name to a concrete command line.
#
# All cases route through /home/Guy008/Scripts/runer.sh which applies
# the user's GPU/CPU/Vulkan acceleration env vars (mangohud + gamemode
# + RADV) before exec'ing the target.
#
# Usage from es_systems.cfg:
#   <command>arch2ram-launch %SYSTEM% %ROM%</command>
#
# Manual:
#   arch2ram-launch snes /path/to/game.smc
#   arch2ram-launch apps /home/Guy008/ES/apps/firefox.desktop

set -e

SYSTEM="${1:?usage: $0 <SYSTEM> <ROM>}"
# Log this launch for the "Recent" category
[[ -n "$HOME" ]] && echo "$(date +%H:%M)  $SYSTEM  $(basename "$ROM" 2>/dev/null || echo "$ROM")" >> "$HOME/.arch2ram-recent.log" 2>/dev/null || true
ROM="${2:?usage: $0 <SYSTEM> <ROM>}"
RUNER="${RUNER:-/home/Guy008/Scripts/runer.sh}"

# Fall back to plain exec if runer.sh missing (don't block the user).
if [[ ! -x "$RUNER" ]]; then
    RUNER=/usr/bin/env
fi

# Resolve libretro core path lazily so we don't fail at script-load.
core() {
    local name="$1"
    local path="/usr/lib/libretro/${name}_libretro.so"
    [[ -f "$path" ]] || {
        echo "ERROR: libretro core not installed: $path" >&2
        echo "  install with: sudo pacman -S libretro-${name//_/-}" >&2
        exit 2
    }
    echo "$path"
}

case "$SYSTEM" in
    # ─── Generic apps via .desktop (Lutris exports, system apps, Steam shortcuts) ─
    apps)
        BASENAME="$(basename "$ROM" .desktop)"
        exec "$RUNER" gtk-launch "$BASENAME"
        ;;

    # ─── Native Linux: run the wrapper or binary directly ─────────────────────
    linux|native)
        exec "$RUNER" "$ROM"
        ;;

    # ─── Windows games via wine (or pre-wrapped .sh that already calls wine) ──
    windows)
        if [[ "$ROM" == *.sh ]]; then
            exec "$RUNER" "$ROM"
        else
            exec "$RUNER" wine "$ROM"
        fi
        ;;

    # ─── Steam — single Big Picture entry (the wrapper .sh handles it) ────────
    steam)
        exec "$RUNER" "$ROM"
        ;;

    # ─── Websites — .url/.txt file containing a URL, opens in chrome ──────────
    # Format: first non-empty, non-comment line in the file = URL.
    # Inspired by Batocera.PLUS's "internet" system.
    websites|internet|browser)
        url="$(grep -vE '^\s*(#|$)' "$ROM" | head -1 | tr -d '[:space:]')"
        [[ -z "$url" ]] && { echo "ERROR: $ROM has no URL"; exit 2; }
        # Chrome first (existing user pref), then Firefox, then xdg-open
        if command -v google-chrome-stable &>/dev/null; then
            exec "$RUNER" google-chrome-stable --start-fullscreen --app="$url"
        elif command -v google-chrome &>/dev/null; then
            exec "$RUNER" google-chrome --start-fullscreen --app="$url"
        elif command -v firefox &>/dev/null; then
            exec "$RUNER" firefox --kiosk "$url"
        else
            exec "$RUNER" xdg-open "$url"
        fi
        ;;

    # ─── Media — Movies / Series — mpv fullscreen with deinterlace ────────────
    movies|series|video)
        exec "$RUNER" mpv \
            --fs \
            --no-osc \
            --hwdec=auto-safe \
            --deinterlace=auto \
            --keep-open=yes \
            "$ROM"
        ;;

    # ─── Live TV / IPTV — m3u playlist or HLS URL via mpv ─────────────────────
    # The "ROM" can be a .m3u playlist file or a .sh wrapper that runs mpv
    # directly. mpv handles both .m3u local files and remote HLS URLs.
    livetv|iptv|tv)
        if [[ "$ROM" == *.sh ]]; then
            exec "$RUNER" "$ROM"
        else
            exec "$RUNER" mpv \
                --fs \
                --no-osc \
                --hwdec=auto-safe \
                --cache=yes \
                --cache-secs=10 \
                --force-seekable=yes \
                "$ROM"
        fi
        ;;

    # ─── Music — local audio files via mpv (no video output) ──────────────────
    music|audio)
        exec "$RUNER" mpv --no-video --shuffle "$ROM"
        ;;

    # ─── Photos — image viewer (feh fullscreen with slideshow) ────────────────
    photos|pictures)
        if command -v feh &>/dev/null; then
            exec "$RUNER" feh -F -D 5 "$(dirname "$ROM")"
        elif command -v gwenview &>/dev/null; then
            exec "$RUNER" gwenview "$ROM"
        else
            exec "$RUNER" xdg-open "$ROM"
        fi
        ;;

    # ─── System actions — .sh wrappers that issue grub-reboot, shutdown, etc ─
    # The .sh files themselves contain the shell commands; we just run them
    # without going through runer.sh (no GPU overlay for a reboot).
    actions|system)
        exec /bin/bash "$ROM"
        ;;

    # ─── SSH — wrappers connect to a remote host in a konsole window ──────────
    ssh)
        exec /bin/bash "$ROM"
        ;;

    # ─── Network shares / Drives / Settings — all just bash wrappers ──────────
    shares|drives|settings)
        exec /bin/bash "$ROM"
        ;;

    # ─── YouTube — .yt files contain a search query OR a video URL ────────────
    # First non-comment line is the query/URL. yt-dlp resolves; mpv plays.
    youtube|yt)
        target="$(grep -vE '^\s*(#|$)' "$ROM" | head -1)"
        [[ -z "$target" ]] && { echo "ERROR: empty $ROM"; exit 2; }
        if [[ "$target" =~ ^https?:// ]]; then
            # Direct URL — let mpv+yt-dlp handle it
            exec "$RUNER" mpv --fs --ytdl-format='bestvideo[height<=2160]+bestaudio/best' "$target"
        else
            # Search query — search YouTube via yt-dlp, play first result
            exec "$RUNER" mpv --fs --ytdl-format='bestvideo[height<=2160]+bestaudio/best' "ytsearch1:$target"
        fi
        ;;

    # ─── Wake-on-LAN — .wol files contain a MAC address ───────────────────────
    wol|wake)
        mac="$(grep -vE '^\s*(#|$)' "$ROM" | head -1)"
        [[ -z "$mac" ]] && { echo "ERROR: no MAC in $ROM"; exit 2; }
        if command -v wol &>/dev/null; then
            wol "$mac"
        elif command -v wakeonlan &>/dev/null; then
            wakeonlan "$mac"
        else
            echo "ERROR: install 'wol' or 'wakeonlan'" >&2; exit 2
        fi
        # Notify result via notify-send if available
        command -v notify-send &>/dev/null && notify-send "Wake-on-LAN" "Magic packet sent to $mac"
        ;;

    # ─── Surround-pro — Guy008's spatial sound project ─────────────────────────
    # .txt files contain a YouTube URL or song name. Surround-pro generates a
    # 5-channel-mix MKV in /home/Guy008/Scripts/surround-pro/output/
    surround|surroundpro)
        target="$(grep -vE '^\s*(#|$)' "$ROM" | head -1)"
        [[ -z "$target" ]] && { echo "ERROR: empty $ROM"; exit 2; }
        cd /home/Guy008/Scripts/surround-pro || exit 2
        # Run surround-pro in a konsole window so user sees progress
        exec konsole --hold -e bash -c "./surround-pro.sh '$target' && echo '---' && echo 'Done. Output in ./output/'; read -p 'Press enter to close...'"
        ;;

    # ─── AI queries — .prompt files contain a prompt sent to an AI agent ─────
    # Whole file content is the prompt (comments stripped, blanks collapsed).
    # Response displayed in konsole; saved next to the .prompt file as .reply.
    # Tries claude (Anthropic) first, then ollama (local), then a stub.
    ai|queries|chat)
        # Read prompt: strip "# ..." comments and empty lines
        prompt="$(grep -vE '^\s*#' "$ROM" | sed '/^[[:space:]]*$/d')"
        [[ -z "$prompt" ]] && { echo "ERROR: empty prompt in $ROM"; exit 2; }

        # Where to save the response
        reply_file="${ROM%.prompt}.reply"
        ts="$(date '+%Y-%m-%d %H:%M:%S')"

        # Pick provider
        if command -v /home/Guy008/.local/bin/claude &>/dev/null; then
            ai_cmd="/home/Guy008/.local/bin/claude -p --bare"
            ai_name="Claude (claude-code CLI)"
        elif command -v claude &>/dev/null; then
            ai_cmd="claude -p"
            ai_name="Claude (claude-code CLI)"
        elif command -v ollama &>/dev/null; then
            # Pick a small model that might be installed
            for model in llama3.2 llama3 mistral phi3; do
                if ollama list 2>/dev/null | grep -q "^$model"; then
                    ai_cmd="ollama run $model"
                    ai_name="Ollama: $model"
                    break
                fi
            done
            : "${ai_cmd:=ollama run llama3.2}"
            : "${ai_name:=Ollama (default model)}"
        else
            ai_cmd=""
        fi

        if [[ -z "$ai_cmd" ]]; then
            # No agent installed — open konsole with install instructions
            exec konsole --hold -e bash -c "
echo 'ERROR: no AI agent installed.'
echo ''
echo 'To enable AI Queries category, install one of:'
echo '  yay -S claude-code         # Anthropic Claude (subscription)'
echo '  sudo pacman -S ollama      # Local LLM, no subscription'
echo '  ollama pull llama3.2       # (small, fast, ~2GB)'
echo ''
echo 'Then re-launch this entry.'
read -p 'Press enter to close...'
"
        fi

        # Run the AI in konsole, save reply, keep window open to see result
        exec konsole --hold -e bash -c "
echo '═══════════════════════════════════════'
echo '  AI Query  ·  ${ai_name}'
echo '  Prompt file: $(basename "$ROM")'
echo '  Time: $ts'
echo '═══════════════════════════════════════'
echo ''
echo '── PROMPT ──'
echo \"$prompt\"
echo ''
echo '── RESPONSE ──'
echo ''
# Run + tee to reply file
echo \"$prompt\" | $ai_cmd 2>&1 | tee '$reply_file'
echo ''
echo '═══════════════════════════════════════'
echo '  Reply saved to: $(basename "$reply_file")'
echo '═══════════════════════════════════════'
read -p 'Press enter to close...'
"
        ;;

    # ─── Nintendo: NES / SNES / N64 / GB / GBC / GBA / NDS ────────────────────
    # NES: prefer mesen (accurate), fceumm if available
    nes)
        for c in mesen fceumm nestopia; do
            p="/usr/lib/libretro/${c}_libretro.so"
            [[ -f "$p" ]] && exec "$RUNER" retroarch -L "$p" "$ROM"
        done
        echo "ERROR: no NES core (try: sudo pacman -S libretro-mesen)" >&2; exit 2
        ;;
    # SNES: bsnes (accurate), snes9x fallback
    snes)
        for c in bsnes snes9x mesen-s bsnes_hd; do
            p="/usr/lib/libretro/${c}_libretro.so"
            [[ -f "$p" ]] && exec "$RUNER" retroarch -L "$p" "$ROM"
        done
        echo "ERROR: no SNES core (try: sudo pacman -S libretro-bsnes)" >&2; exit 2
        ;;
    n64)               exec "$RUNER" retroarch -L "$(core mupen64plus_next)"   "$ROM" ;;
    gb|gameboy)        exec "$RUNER" retroarch -L "$(core gambatte)"           "$ROM" ;;
    gbc|gameboycolor)  exec "$RUNER" retroarch -L "$(core gambatte)"           "$ROM" ;;
    gba|gameboyadvance) exec "$RUNER" retroarch -L "$(core mgba)"              "$ROM" ;;
    nds|nintendods)    exec "$RUNER" retroarch -L "$(core melonds)"            "$ROM" ;;
    n3ds|3ds)
        # Citra dead, fork Azahar in AUR. RetroArch core not stable.
        if command -v citra-qt &>/dev/null; then
            exec "$RUNER" citra-qt "$ROM"
        elif command -v azahar &>/dev/null; then
            exec "$RUNER" azahar "$ROM"
        else
            echo "ERROR: no 3DS emulator installed (try azahar / citra-qt)" >&2; exit 2
        fi
        ;;
    switch)
        if command -v ryujinx &>/dev/null; then
            exec "$RUNER" ryujinx "$ROM"
        elif command -v Ryujinx &>/dev/null; then
            exec "$RUNER" Ryujinx "$ROM"
        else
            echo "ERROR: ryujinx not installed" >&2; exit 2
        fi
        ;;

    # ─── Sega: Genesis/MegaDrive / Master System / 32X / SegaCD / Saturn ──────
    megadrive|genesis)        exec "$RUNER" retroarch -L "$(core genesis_plus_gx)" "$ROM" ;;
    mastersystem)             exec "$RUNER" retroarch -L "$(core genesis_plus_gx)" "$ROM" ;;
    sega32x|32x)              exec "$RUNER" retroarch -L "$(core picodrive)"       "$ROM" ;;
    segacd)                   exec "$RUNER" retroarch -L "$(core genesis_plus_gx)" "$ROM" ;;
    saturn)                   exec "$RUNER" retroarch -L "$(core mednafen_saturn)" "$ROM" ;;
    dreamcast)
        if command -v flycast &>/dev/null; then
            exec "$RUNER" flycast "$ROM"
        else
            exec "$RUNER" retroarch -L "$(core flycast)" "$ROM"
        fi
        ;;

    # ─── Sony: PSX (PS1) / PS2 / PS3 / PSP ────────────────────────────────────
    psx|ps1|playstation)
        # Prefer standalone DuckStation, fallback to beetle-psx (libretro)
        if command -v duckstation-qt &>/dev/null; then
            exec "$RUNER" duckstation-qt -fullscreen "$ROM"
        elif command -v duckstation &>/dev/null; then
            exec "$RUNER" duckstation -fullscreen "$ROM"
        else
            for c in mednafen_psx_hw beetle_psx_hw mednafen_psx beetle_psx pcsx_rearmed; do
                p="/usr/lib/libretro/${c}_libretro.so"
                [[ -f "$p" ]] && exec "$RUNER" retroarch -L "$p" "$ROM"
            done
            echo "ERROR: no PSX core (try: sudo pacman -S libretro-beetle-psx-hw)" >&2; exit 2
        fi
        ;;
    ps2)
        if command -v pcsx2-qt &>/dev/null; then
            exec "$RUNER" pcsx2-qt -fullscreen "$ROM"
        else
            exec "$RUNER" pcsx2 -fullscreen "$ROM"
        fi
        ;;
    ps3)
        if command -v rpcs3 &>/dev/null; then
            exec "$RUNER" rpcs3 --no-gui "$ROM"
        else
            echo "ERROR: rpcs3 not installed (install from AUR)" >&2; exit 2
        fi
        ;;
    psp)
        if command -v PPSSPPQt &>/dev/null; then
            exec "$RUNER" PPSSPPQt -fullscreen "$ROM"
        else
            exec "$RUNER" retroarch -L "$(core ppsspp)" "$ROM"
        fi
        ;;

    # ─── Microsoft: Xbox / Xbox 360 ───────────────────────────────────────────
    xbox)
        command -v xemu &>/dev/null || { echo "ERROR: xemu not installed (AUR)" >&2; exit 2; }
        exec "$RUNER" xemu -dvd_path "$ROM" -full-screen
        ;;
    xbox360)
        command -v xenia &>/dev/null || { echo "ERROR: xenia not installed (AUR)" >&2; exit 2; }
        exec "$RUNER" xenia "$ROM"
        ;;

    # ─── Nintendo home consoles: GameCube / Wii / Wii U ───────────────────────
    gamecube|gc|wii)
        command -v dolphin-emu &>/dev/null || { echo "ERROR: dolphin-emu not installed" >&2; exit 2; }
        exec "$RUNER" dolphin-emu --batch --exec="$ROM"
        ;;
    wiiu)
        command -v cemu &>/dev/null || { echo "ERROR: cemu not installed (AUR)" >&2; exit 2; }
        exec "$RUNER" cemu --fullscreen --game "$ROM"
        ;;

    # ─── Atari ────────────────────────────────────────────────────────────────
    atari2600)  exec "$RUNER" retroarch -L "$(core stella)"      "$ROM" ;;
    atari5200)  exec "$RUNER" retroarch -L "$(core atari800)"    "$ROM" ;;
    atari7800)  exec "$RUNER" retroarch -L "$(core prosystem)"   "$ROM" ;;
    atarilynx)  exec "$RUNER" retroarch -L "$(core handy)"       "$ROM" ;;
    jaguar)     exec "$RUNER" retroarch -L "$(core virtualjaguar)" "$ROM" ;;

    # ─── PC / DOS ─────────────────────────────────────────────────────────────
    dos|dosbox)
        if command -v dosbox-staging &>/dev/null; then
            exec "$RUNER" dosbox-staging "$ROM"
        else
            exec "$RUNER" dosbox "$ROM"
        fi
        ;;

    # ─── Arcade ───────────────────────────────────────────────────────────────
    arcade|mame|fbneo)
        if command -v mame &>/dev/null; then
            exec "$RUNER" mame "$ROM"
        else
            exec "$RUNER" retroarch -L "$(core mame)" "$ROM"
        fi
        ;;

    # ─── Catch-all: unknown system — try a libretro core named after it ───────
    *)
        guessed="/usr/lib/libretro/${SYSTEM}_libretro.so"
        if [[ -f "$guessed" ]]; then
            exec "$RUNER" retroarch -L "$guessed" "$ROM"
        fi
        echo "ERROR: unknown system '$SYSTEM' and no libretro core named '${SYSTEM}_libretro.so'" >&2
        echo "  add a case for it in $(basename "$0") or rename the system" >&2
        exit 1
        ;;
esac
