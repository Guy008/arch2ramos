#!/bin/bash
# arch2ram-es-discover — populate ~/ES/ with wrappers for installed apps & games.
#
# Reads from these known locations on the system:
#   /usr/share/applications/   → Apps (.desktop files, filtered by NoDisplay)
#   /media/G/Linux/*/          → Linux games (entry = run.sh or named binary)
#   /media/G/Windows/*/        → Windows games (entry = .exe via wine)
#   /media/G/Steam/            → just "Steam Big Picture" entry
#   /media/R/batocera/roms/*   → Batocera ROMs (one ES system per subdir; needs cores)
#
# Idempotent: re-running cleans + re-populates ~/ES/.
#
# Run from disk mode by the user (not root):
#   /home/$USER/Scripts/ramos/arch2ramos/scripts/arch2ram-es-discover

set -e

USER_HOME="${HOME:-/home/$(whoami)}"
RUNER="${RUNER:-$USER_HOME/Scripts/runer.sh}"
ES_ROOT="$USER_HOME/ES"

# Categories
APPS_DIR="$ES_ROOT/apps"
LINUX_DIR="$ES_ROOT/linux"
WIN_DIR="$ES_ROOT/windows"
STEAM_DIR="$ES_ROOT/steam"

mkdir -p "$APPS_DIR" "$LINUX_DIR" "$WIN_DIR" "$STEAM_DIR"

# ─── Apps from /usr/share/applications (only "visible" ones) ──────────────────
echo "[apps] Scanning /usr/share/applications/..."
# Clean existing symlinks (idempotent)
find "$APPS_DIR" -maxdepth 1 -type l -delete 2>/dev/null || true
count=0
skipped=0
for desktop in /usr/share/applications/*.desktop; do
    [[ -f "$desktop" ]] || continue
    # Skip Hidden=true or NoDisplay=true entries (system internals, MIME helpers)
    if grep -qiE "^(NoDisplay|Hidden)\s*=\s*true" "$desktop"; then
        skipped=$((skipped + 1))
        continue
    fi
    # Must have an Exec= line
    grep -q "^Exec=" "$desktop" || { skipped=$((skipped + 1)); continue; }
    # Symlink (so the symlink's basename = the original .desktop name,
    # which gtk-launch needs)
    ln -sf "$desktop" "$APPS_DIR/$(basename "$desktop")"
    count=$((count + 1))
done
echo "  → $count apps   (skipped $skipped Hidden/NoDisplay/no-Exec)"

# ─── Linux games from /media/G/Linux ──────────────────────────────────────────
echo "[linux] Scanning /media/G/Linux/..."
rm -f "$LINUX_DIR"/*.sh 2>/dev/null || true
count=0
if [[ -d /media/G/Linux ]]; then
    for gamedir in /media/G/Linux/*/; do
        [[ -d "$gamedir" ]] || continue
        gamedir="${gamedir%/}"   # strip trailing slash
        name="$(basename "$gamedir")"

        # Entry-point detection:
        #   1. run.sh    (most common — pre-made launcher in game dir)
        #   2. <name> binary  (e.g. /media/G/Linux/Cuphead.../Cuphead)
        #   3. *.x86_64 / *.x86 / *.AppImage  (Unity/SDL games)
        target=""
        if [[ -x "$gamedir/run.sh" ]]; then
            target="$gamedir/run.sh"
        elif [[ -x "$gamedir/$name" && -f "$gamedir/$name" ]]; then
            target="$gamedir/$name"
        else
            target="$(find "$gamedir" -maxdepth 1 -type f \
                \( -name '*.x86_64' -o -name '*.x86' -o -name '*.AppImage' -o -name '*.sh' \) \
                -executable 2>/dev/null | head -1)"
        fi

        if [[ -n "$target" ]]; then
            wrapper="$LINUX_DIR/$name.sh"
            cat > "$wrapper" <<EOF
#!/bin/bash
# Auto-generated by arch2ram-es-discover
cd "$gamedir" && exec "$target" "\$@"
EOF
            chmod +x "$wrapper"
            count=$((count + 1))
        fi
    done
fi
echo "  → $count Linux games"

# ─── Windows games from /media/G/Windows (via wine) ───────────────────────────
echo "[windows] Scanning /media/G/Windows/..."
rm -f "$WIN_DIR"/*.sh 2>/dev/null || true
count=0
if [[ -d /media/G/Windows ]]; then
    for gamedir in /media/G/Windows/*/; do
        [[ -d "$gamedir" ]] || continue
        gamedir="${gamedir%/}"
        name="$(basename "$gamedir")"

        # Heuristic for "the" .exe to run: prefer one matching the dir name,
        # else the largest .exe (skips small uninstallers)
        target="$(find "$gamedir" -maxdepth 3 -type f -iname "*.exe" 2>/dev/null \
            | awk -F/ -v n="${name,,}" '
                BEGIN { best=""; best_score=-1 }
                {
                    fn = tolower($NF)
                    sub(/\.exe$/,"",fn)
                    score = 0
                    if (fn == n) score = 100
                    else if (index(n, fn) || index(fn, n)) score = 50
                    if (score > best_score) { best_score = score; best = $0 }
                }
                END { print best }')"
        # Fallback: just first .exe
        [[ -z "$target" ]] && target="$(find "$gamedir" -maxdepth 3 -type f -iname "*.exe" 2>/dev/null | head -1)"

        if [[ -n "$target" ]]; then
            wrapper="$WIN_DIR/$name.sh"
            cat > "$wrapper" <<EOF
#!/bin/bash
# Auto-generated by arch2ram-es-discover (via wine)
cd "$gamedir" && exec wine "$target" "\$@"
EOF
            chmod +x "$wrapper"
            count=$((count + 1))
        fi
    done
fi
echo "  → $count Windows games (need 'wine' installed at runtime)"

# ─── Steam Big Picture (one entry) ────────────────────────────────────────────
echo "[steam] Installing Steam Big Picture entry..."
cat > "$STEAM_DIR/Steam Big Picture.sh" <<'EOF'
#!/bin/bash
# Auto-generated by arch2ram-es-discover
exec /usr/bin/steam -bigpicture
EOF
chmod +x "$STEAM_DIR/Steam Big Picture.sh"
echo "  → 1 entry"

echo ""
echo "Discovery complete. Inventory:"
for d in apps linux windows steam; do
    n=$(find "$ES_ROOT/$d" -maxdepth 1 -type f -o -type l 2>/dev/null | wc -l)
    printf "  %-10s %d entries\n" "$d" "$n"
done
