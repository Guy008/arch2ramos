#!/bin/bash
# arch2ram-pick-primary-gpu -- on multi-GPU systems, mark the GPU that
# actually has a connected display as the primary device for the session.
#
# Ports Batocera's S30checkprime. The pattern:
#   1. enumerate all VGA/3D controllers via lspci
#   2. for each, find its /sys/class/drm/card<N>
#   3. check its connectors for "connected" status
#   4. the first with a live connector wins
#
# Action depends on which vendor won:
#   - NVIDIA: write a /etc/X11/xorg.conf.d snippet pinning PrimaryGPU="yes"
#             on the nvidia BusID, and PRIME_RUN env hints.
#   - AMD/Intel: write /etc/environment hints (DRI_PRIME, VK_ICD_FILENAMES).
#
# Single-GPU systems: silent no-op.
# arch2ram-drm-fixup still runs separately to unbind simpledrm before this.

LOG="/var/log/arch2ram-pick-primary-gpu.log"
ENV_FILE="/etc/arch2ram/gpu.env"
XORG_FILE="/etc/X11/xorg.conf.d/10-arch2ram-prime.conf"

mkdir -p "$(dirname "$ENV_FILE")"

log() {
    echo "$@"
    echo "$@" >> "$LOG"
}
log ""
log "[$(date '+%Y-%m-%d %H:%M:%S')] arch2ram-pick-primary-gpu"

# Enumerate GPUs by PCI class code 03xx (display controllers).
# Earlier we used grep "(VGA|3D|Display controller)" which falsely
# matched any device with "3D" in its description (e.g. "SanDisk Ultra 3D").
mapfile -t GPUS < <(lspci -nn | grep -E '\[03[0-9a-fA-F]{2}\]:')
GPU_COUNT="${#GPUS[@]}"

if (( GPU_COUNT <= 1 )); then
    log "single GPU -- skipping"
    rm -f "$ENV_FILE" "$XORG_FILE" 2>/dev/null
    exit 0
fi

log "$GPU_COUNT GPUs detected:"
for g in "${GPUS[@]}"; do log "  $g"; done

# Find connected GPU
CONNECTED_PCI=""
CONNECTED_VENDOR=""
CONNECTED_CARD=""

for gpu_entry in "${GPUS[@]}"; do
    pci_id="${gpu_entry%% *}"
    # vendor (NVIDIA/AMD/Intel) hint from lspci description
    vendor=""
    case "$gpu_entry" in
        *NVIDIA*|*nvidia*) vendor="nvidia" ;;
        *AMD*|*Advanced\ Micro\ Devices*|*ATI*) vendor="amd" ;;
        *Intel*) vendor="intel" ;;
        *) vendor="unknown" ;;
    esac

    # Find DRM card for this PCI ID
    drm_card=""
    for card_path in /sys/class/drm/card*; do
        [[ -d "$card_path" ]] || continue
        # card_path might be card0, card0-eDP-1, etc. -- only top-level
        case "$(basename "$card_path")" in card[0-9]*) ;; *) continue ;; esac
        if readlink -f "$card_path/device" 2>/dev/null | grep -q "$pci_id"; then
            drm_card="$(basename "$card_path")"
            break
        fi
    done
    [[ -z "$drm_card" ]] && continue

    # Check for at least one connected connector
    found_connection=0
    for status_file in /sys/class/drm/${drm_card}-*/status; do
        [[ -f "$status_file" ]] || continue
        if [[ "$(cat "$status_file")" == "connected" ]]; then
            found_connection=1
            break
        fi
    done

    if (( found_connection )); then
        CONNECTED_PCI="$pci_id"
        CONNECTED_VENDOR="$vendor"
        CONNECTED_CARD="$drm_card"
        break
    fi
done

if [[ -z "$CONNECTED_PCI" ]]; then
    log "WARNING: multiple GPUs but none have connected displays!"
    log "Falling back to first listed GPU."
    CONNECTED_PCI="${GPUS[0]%% *}"
    case "${GPUS[0]}" in
        *NVIDIA*) CONNECTED_VENDOR="nvidia" ;;
        *AMD*|*ATI*) CONNECTED_VENDOR="amd" ;;
        *Intel*) CONNECTED_VENDOR="intel" ;;
        *) CONNECTED_VENDOR="unknown" ;;
    esac
fi

log "selected primary: $CONNECTED_PCI ($CONNECTED_VENDOR) at $CONNECTED_CARD"

# Emit env file for later use (arch2ram-launch, gamescope wrapper, etc.)
cat > "$ENV_FILE" <<EOF
# Auto-generated by arch2ram-pick-primary-gpu. Do not edit.
ARCH2RAM_GPU_PCI=$CONNECTED_PCI
ARCH2RAM_GPU_VENDOR=$CONNECTED_VENDOR
ARCH2RAM_GPU_CARD=$CONNECTED_CARD
EOF

# Per-vendor configuration
case "$CONNECTED_VENDOR" in
    nvidia)
        # Convert PCI ID 0000:01:00.0 -> BusID "PCI:1:0:0" for xorg
        bus_id=$(echo "$CONNECTED_PCI" | awk -F: '{printf "PCI:%d:%d:%d", strtonum("0x"$2), strtonum("0x"$3), strtonum("0x"substr($4,1,1))}' )
        mkdir -p /etc/X11/xorg.conf.d
        cat > "$XORG_FILE" <<XORGEOF
# Auto-generated by arch2ram-pick-primary-gpu
Section "OutputClass"
    Identifier "nvidia"
    MatchDriver "nvidia-drm"
    Driver "nvidia"
    Option "AllowEmptyInitialConfiguration"
    Option "PrimaryGPU" "yes"
    ModulePath "/usr/lib/nvidia/xorg"
    ModulePath "/usr/lib/xorg/modules"
EndSection
XORGEOF
        log "wrote $XORG_FILE (NVIDIA primary, BusID $bus_id)"
        ;;
    amd|intel)
        # For AMD/Intel selected as primary, prefer the matching ICD.
        # DRI_PRIME=1 not needed when the connected GPU is already primary.
        rm -f "$XORG_FILE" 2>/dev/null
        log "removed any stale xorg PrimaryGPU rule (AMD/Intel auto-detected)"
        ;;
    *)
        log "unknown vendor -- no special configuration written"
        ;;
esac

log "done"
