#!/bin/bash
# arch2ramos: gamescope + EmulationStation production-grade launcher.
#
# Boot flow: gamescope owns DRM, ES runs inside it. The user picks an entry,
# /usr/local/bin/arch2ram-launch fires, the target binary takes over the
# gamescope canvas, returns to ES on exit.
#
# This wrapper runs an exit-loop. Trigger files left by ES Actions:
#
#   /tmp/arch2ram.shutdown        -> poweroff
#   /tmp/arch2ram.reboot          -> reboot
#   /tmp/arch2ram.restart-es      -> relaunch ES (read config changes, etc.)
#
# Sibling-compositor flags (the "compositor-as-an-app" pattern):
#
#   /tmp/arch2ram.run-hyprland    -> run hyprland (with its own DRM, no
#                                    gamescope wrapping), then return to ES
#   /tmp/arch2ram.run-steam-bpm   -> run gamescope+Steam Big Picture,
#                                    then return to ES
#   /tmp/arch2ram.run-kiosk       -> run cage+konsole kiosk shell,
#                                    then return to ES
#
# Each "run-*" flag is dropped before the compositor runs, and the loop
# falls through to ES on exit. The Action scripts in ~/ES/actions/ just
# `touch` the flag and `pkill emulationstation` -- the wrapper handles
# the rest.
#
# This is the same pattern Batocera's emulationstation-standalone uses
# but extended to treat every compositor as just another "app" in the
# launcher.

set -u   # not -e; we WANT to keep going if ES segfaults

# -------- pre-launch: env + display readiness ---------------------------------

# Wait for DRM devices (drm-fixup runs before us)
for _ in 1 2 3 4 5; do
    [[ -e /dev/dri/card0 ]] && break
    sleep 0.5
done

# Wayland runtime dir
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
if [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 700 "$XDG_RUNTIME_DIR"
fi
export XDG_SESSION_TYPE=wayland

# Hebrew/English keyboard
export XKB_DEFAULT_LAYOUT=us,il
export XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle

# Locale
export LANG=he_IL.UTF-8
export LC_CTYPE=he_IL.UTF-8

# MangoHud globally
export MANGOHUD=1

# Output res -- same overrides as gamescope mode
WIDTH=3840
HEIGHT=2160
RATE=60
if [[ -r /proc/cmdline ]]; then
    res="$(grep -oE 'arch2ram\.es\.res=[0-9]+x[0-9]+' /proc/cmdline | tail -1 | cut -d= -f2)"
    [[ -n "$res" ]] && { WIDTH="${res%x*}"; HEIGHT="${res#*x}"; }
    rate="$(grep -oE 'arch2ram\.es\.rate=[0-9]+' /proc/cmdline | tail -1 | cut -d= -f2)"
    [[ -n "$rate" ]] && RATE="$rate"
fi

# -------- trigger-file helpers ------------------------------------------------

clear_triggers() {
    rm -f /tmp/arch2ram.shutdown \
          /tmp/arch2ram.reboot \
          /tmp/arch2ram.restart-es \
          /tmp/arch2ram.run-hyprland \
          /tmp/arch2ram.run-steam-bpm \
          /tmp/arch2ram.run-kiosk \
          /tmp/arch2ram.switch-mode* 2>/dev/null
}

handle_exit_triggers() {
    # Called after ES exits or a "run-*" compositor exits. Handles only
    # shutdown/reboot here; run-* triggers are checked at the top of the loop.
    if [[ -f /tmp/arch2ram.shutdown ]]; then
        rm -f /tmp/arch2ram.shutdown
        echo "arch2ram-emulationstation: shutdown trigger"
        systemctl poweroff
        exit 0
    fi
    if [[ -f /tmp/arch2ram.reboot ]]; then
        rm -f /tmp/arch2ram.reboot
        echo "arch2ram-emulationstation: reboot trigger"
        systemctl reboot
        exit 0
    fi
}

# -------- "run X as an app" handlers -----------------------------------------
#
# Each function blocks until the compositor exits, then returns. The caller
# (the main loop) will `continue` which relaunches ES.

run_hyprland() {
    echo "arch2ram-emulationstation: running Hyprland as a sibling compositor"
    # Critical: wait for gamescope to fully release the DRM device, AND wipe
    # the WAYLAND_DISPLAY / DISPLAY env vars that Hyprland inherits from the
    # gamescope session -- otherwise Hyprland tries to nest inside the dead
    # gamescope socket and crashes silently in under a second (presenting
    # the user with a brief black flash and instant ES relaunch).
    sleep 2
    # Persistent log -- /tmp is volatile under tmpfs RAM mode, /home is not.
    LOG="${HOME:-/home/Guy008}/.arch2ram-launcher.log"
    {
        echo "[$(date '+%H:%M:%S')] launching Hyprland"
        echo "  binary: $(which hyprland)"
        echo "  config: /etc/arch2ram/hyprland-ram.conf"
    } >> "$LOG" 2>&1
    env -u WAYLAND_DISPLAY -u DISPLAY -u GAMESCOPE_WAYLAND_DISPLAY -u XAUTHORITY \
        XDG_RUNTIME_DIR="/run/user/$(id -u)" \
        XDG_CURRENT_DESKTOP=Hyprland \
        XDG_SESSION_TYPE=wayland \
        setpriv --ambient-caps '-all' \
            hyprland --config /etc/arch2ram/hyprland-ram.conf \
        >> "$LOG" 2>&1
    echo "[$(date '+%H:%M:%S')] Hyprland exited code $?" >> "$LOG"
}

run_steam_bpm() {
    echo "arch2ram-emulationstation: running Steam Big Picture in gamescope"
    XDG_CURRENT_DESKTOP=gamescope \
        setpriv --ambient-caps '-all' \
            gamescope -W "$WIDTH" -H "$HEIGHT" -r "$RATE" -f \
                --force-grab-cursor --adaptive-sync \
                -- steam -tenfoot
}

run_kiosk() {
    echo "arch2ram-emulationstation: running kiosk (cage+konsole)"
    XDG_CURRENT_DESKTOP=cage \
        setpriv --ambient-caps '-all' \
            cage -- konsole --profile arch2ram-kiosk
}

# -------- recovery shell -----------------------------------------------------

recovery_shell() {
    # Last-resort: drop into a terminal inside gamescope so the screen isn't
    # black. Useful if ES crashes early or its config is broken.
    echo ""
    echo "  ==============================================================="
    echo "  ES exited unexpectedly. Dropping to recovery shell."
    echo "  Run 'emulationstation' to retry, or 'systemctl reboot' to reset."
    echo "  ==============================================================="
    echo ""
    if command -v konsole >/dev/null; then
        exec setpriv --ambient-caps '-all' \
            gamescope -W "$WIDTH" -H "$HEIGHT" -r "$RATE" -f \
                --force-grab-cursor -- konsole --hold
    else
        exec bash -l
    fi
}

# -------- main loop -----------------------------------------------------------

clear_triggers   # ignore stale flags from previous boot

LOOP_GUARD=0
MAX_RAPID_RESTARTS=5

while true; do
    LAST_START=$(date +%s)

    # ── Sibling-compositor pre-checks ──────────────────────────────────────
    # If a "run X" flag was set (typically by an ES Action), run that
    # compositor in place of ES this iteration, then loop -- which will
    # re-launch ES on the next pass.
    if [[ -f /tmp/arch2ram.run-hyprland ]]; then
        rm -f /tmp/arch2ram.run-hyprland
        run_hyprland
        echo "arch2ram-emulationstation: Hyprland exited -- returning to ES"
        continue
    fi
    if [[ -f /tmp/arch2ram.run-steam-bpm ]]; then
        rm -f /tmp/arch2ram.run-steam-bpm
        run_steam_bpm
        echo "arch2ram-emulationstation: Steam BPM exited -- returning to ES"
        continue
    fi
    if [[ -f /tmp/arch2ram.run-kiosk ]]; then
        rm -f /tmp/arch2ram.run-kiosk
        run_kiosk
        echo "arch2ram-emulationstation: kiosk exited -- returning to ES"
        continue
    fi

    # ── Default: launch ES inside gamescope ────────────────────────────────
    echo "arch2ram-emulationstation: gamescope ${WIDTH}x${HEIGHT}@${RATE} -> emulationstation"

    XDG_CURRENT_DESKTOP=gamescope \
        setpriv --ambient-caps '-all' \
            gamescope \
                -W "$WIDTH" -H "$HEIGHT" -r "$RATE" \
                -f \
                --force-grab-cursor \
                --adaptive-sync \
                -- \
                emulationstation --no-splash
    ES_EXIT=$?

    echo "arch2ram-emulationstation: ES exited with code $ES_EXIT"

    # Shutdown / reboot triggers (these terminate the loop).
    handle_exit_triggers

    if [[ -f /tmp/arch2ram.restart-es ]]; then
        rm -f /tmp/arch2ram.restart-es
        echo "arch2ram-emulationstation: restart trigger -- relaunching"
        continue
    fi

    # If a run-* flag was written DURING the ES session, the next loop
    # iteration will pick it up at the top.
    if [[ -f /tmp/arch2ram.run-hyprland || \
          -f /tmp/arch2ram.run-steam-bpm || \
          -f /tmp/arch2ram.run-kiosk ]]; then
        continue
    fi

    # Rapid-restart guard: if ES crashes 5 times in 60 seconds, give up.
    NOW=$(date +%s)
    if (( NOW - LAST_START < 12 )); then
        ((LOOP_GUARD++))
    else
        LOOP_GUARD=0
    fi
    if (( LOOP_GUARD >= MAX_RAPID_RESTARTS )); then
        echo "arch2ram-emulationstation: too many crashes -- recovery shell"
        recovery_shell
    fi

    # ES exited cleanly without a trigger: relaunch (the user probably hit a
    # menu that quit ES; we shouldn't leave them at a black screen).
    if (( ES_EXIT == 0 )); then
        echo "arch2ram-emulationstation: clean exit, relaunching"
        sleep 1
        continue
    fi

    # ES crashed without a trigger and without rapid-restart: try once more
    echo "arch2ram-emulationstation: crash, retrying in 2s"
    sleep 2
done
