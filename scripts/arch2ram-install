#!/bin/bash
# arch2ram-install — set up Arch Linux to boot from RAM via archiso hooks
#
# Installs up to five boot modes (added to GRUB based on what's available):
#   1. Arch Linux from RAM (gamescope)        — gamescope + Steam BPM (default)
#   2. Arch Linux from RAM (EmulationStation) — gamescope + ES launcher
#   3. Arch Linux from RAM (kiosk)            — cage compositor, single app
#   4. Arch Linux from RAM (hyprland)         — multi-window desktop
#   5. Arch Linux from RAM (debug TTY)        — multi-user.target only, ssh
#
# All modes share:
#   - the same squashfs root (built by arch2ram-create)
#   - the simpledrm-unbind workaround (arch2ram-drm-fixup) for hybrid GPUs
#   - inherited kernel cmdline (GPU tuning, mitigations, nvme, etc.)
#
# Usage:
#   sudo arch2ram-install                        (full install — gamescope default)
#   sudo arch2ram-install --no-gamescope         (skip gamescope install + entry)
#   sudo arch2ram-install --no-emulationstation  (skip ES install + entry)
#   sudo arch2ram-install --no-kiosk             (skip cage install + kiosk entry)
#   sudo arch2ram-install --no-hyprland          (skip hyprland entry)
#   sudo arch2ram-install --default=MODE         (gamescope|es|kiosk|hyprland|debug)

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Source files in the project tree
CONF_SRC="${PROJECT_DIR}/mkinitcpio/arch2ram.conf"
PRESET_SRC="${PROJECT_DIR}/mkinitcpio/arch2ram.preset"
DRM_FIXUP_SCRIPT_SRC="${PROJECT_DIR}/scripts/arch2ram-drm-fixup"
KIOSK_SCRIPT_SRC="${PROJECT_DIR}/scripts/arch2ram-kiosk"
HYPRLAND_SCRIPT_SRC="${PROJECT_DIR}/scripts/arch2ram-hyprland"
GAMESCOPE_SCRIPT_SRC="${PROJECT_DIR}/scripts/arch2ram-gamescope"
ES_SCRIPT_SRC="${PROJECT_DIR}/scripts/arch2ram-emulationstation"
ES_DISCOVER_SRC="${PROJECT_DIR}/scripts/arch2ram-es-discover"
ES_LAUNCH_SRC="${PROJECT_DIR}/scripts/arch2ram-launch"
ES_BOOKMARKS_SRC="${PROJECT_DIR}/scripts/arch2ram-bookmarks"
ES_MUSIC_SRC="${PROJECT_DIR}/scripts/arch2ram-music"
ES_DISCOVER_ALL_SRC="${PROJECT_DIR}/scripts/arch2ram-discover-all"
ES_NEWS_SRC="${PROJECT_DIR}/scripts/arch2ram-news"
ES_THEME_GEN_SRC="${PROJECT_DIR}/scripts/arch2ram-theme-gen"

# Sprint 1: universal hotkeys (triggerhappy + helpers)
TH_RUN_SRC="${PROJECT_DIR}/scripts/arch2ram-th-run"
TH_MOUSE_SRC="${PROJECT_DIR}/scripts/arch2ram-mouse"
TH_SHOT_SRC="${PROJECT_DIR}/scripts/arch2ram-screenshot"
TH_HELP_SRC="${PROJECT_DIR}/scripts/arch2ram-help"
TH_BRIGHT_SRC="${PROJECT_DIR}/scripts/arch2ram-brightness"
TH_KILLFG_SRC="${PROJECT_DIR}/scripts/arch2ram-kill-foreground"
TH_CONF_SRC="${PROJECT_DIR}/triggerhappy/arch2ram.conf"
TH_OVERRIDE_SRC="${PROJECT_DIR}/systemd/triggerhappy.service.d/override.conf"

# Sprint 2: kiosk lockdown
DALTFN_SCRIPT_SRC="${PROJECT_DIR}/scripts/arch2ram-disablealtfn"
DALTFN_UNIT_SRC="${PROJECT_DIR}/systemd/arch2ram-disablealtfn.service"

DRM_FIXUP_UNIT_SRC="${PROJECT_DIR}/systemd/arch2ram-drm-fixup.service"
KIOSK_UNIT_SRC="${PROJECT_DIR}/systemd/arch2ram-kiosk.service"
HYPRLAND_UNIT_SRC="${PROJECT_DIR}/systemd/arch2ram-hyprland.service"
GAMESCOPE_UNIT_SRC="${PROJECT_DIR}/systemd/arch2ram-gamescope.service"
ES_UNIT_SRC="${PROJECT_DIR}/systemd/arch2ram-emulationstation.service"
DRM_ENVGEN_SRC="${PROJECT_DIR}/env/10-arch2ram-drm"
KONSOLE_PROFILE_SRC="${PROJECT_DIR}/konsole/arch2ram-kiosk.profile"
HYPRLAND_CONF_SRC="${PROJECT_DIR}/hyprland/hyprland-ram.conf"
ES_CONF_SRC="${PROJECT_DIR}/emulationstation/es_systems.cfg"

# Install destinations
CONF_DST="/etc/arch2ram/mkinitcpio.conf"
PRESET_DST="/etc/mkinitcpio.d/arch2ram.preset"
INITRAMFS="/boot/initramfs-arch2ram.img"
KERNEL_IMG="/boot/vmlinuz-linux"
DRM_FIXUP_SCRIPT_DST="/usr/local/bin/arch2ram-drm-fixup"
KIOSK_SCRIPT_DST="/usr/local/bin/arch2ram-kiosk"
HYPRLAND_SCRIPT_DST="/usr/local/bin/arch2ram-hyprland"
GAMESCOPE_SCRIPT_DST="/usr/local/bin/arch2ram-gamescope"
ES_SCRIPT_DST="/usr/local/bin/arch2ram-emulationstation"
ES_DISCOVER_DST="/usr/local/bin/arch2ram-es-discover"
ES_LAUNCH_DST="/usr/local/bin/arch2ram-launch"
ES_BOOKMARKS_DST="/usr/local/bin/arch2ram-bookmarks"
ES_MUSIC_DST="/usr/local/bin/arch2ram-music"
ES_DISCOVER_ALL_DST="/usr/local/bin/arch2ram-discover-all"
ES_NEWS_DST="/usr/local/bin/arch2ram-news"
ES_THEME_GEN_DST="/usr/local/bin/arch2ram-theme-gen"

# Sprint 1 destinations
TH_RUN_DST="/usr/local/bin/arch2ram-th-run"
TH_MOUSE_DST="/usr/local/bin/arch2ram-mouse"
TH_SHOT_DST="/usr/local/bin/arch2ram-screenshot"
TH_HELP_DST="/usr/local/bin/arch2ram-help"
TH_BRIGHT_DST="/usr/local/bin/arch2ram-brightness"
TH_KILLFG_DST="/usr/local/bin/arch2ram-kill-foreground"
TH_CONF_DST="/etc/triggerhappy/triggers.d/arch2ram.conf"
TH_OVERRIDE_DST="/etc/systemd/system/triggerhappy.service.d/override.conf"

# Sprint 2 destinations
DALTFN_SCRIPT_DST="/usr/local/bin/arch2ram-disablealtfn"
DALTFN_UNIT_DST="/etc/systemd/system/arch2ram-disablealtfn.service"

DRM_FIXUP_UNIT_DST="/etc/systemd/system/arch2ram-drm-fixup.service"
KIOSK_UNIT_DST="/etc/systemd/system/arch2ram-kiosk.service"
HYPRLAND_UNIT_DST="/etc/systemd/system/arch2ram-hyprland.service"
GAMESCOPE_UNIT_DST="/etc/systemd/system/arch2ram-gamescope.service"
ES_UNIT_DST="/etc/systemd/system/arch2ram-emulationstation.service"
DRM_ENVGEN_DST="/etc/systemd/user-environment-generators/10-arch2ram-drm"
KONSOLE_PROFILE_DST="/usr/share/konsole/arch2ram-kiosk.profile"
HYPRLAND_CONF_DST="/etc/arch2ram/hyprland-ram.conf"
ES_CONF_DST="/etc/emulationstation/es_systems.cfg"

# Also install arch2ram-update + arch2ram-create as system commands so the
# disk-mode update cycle ("sudo arch2ram-update") works from anywhere.
UPDATE_SCRIPT_SRC="${PROJECT_DIR}/scripts/arch2ram-update"
CREATE_SCRIPT_SRC="${PROJECT_DIR}/scripts/arch2ram-create"
UPDATE_SCRIPT_DST="/usr/local/bin/arch2ram-update"
CREATE_SCRIPT_DST="/usr/local/bin/arch2ram-create"

# Support both plain grub and grub-customizer setups
if [[ -f "/etc/grub.d/proxifiedScripts/custom" ]]; then
    GRUB_CUSTOM="/etc/grub.d/proxifiedScripts/custom"
else
    GRUB_CUSTOM="/etc/grub.d/40_custom"
fi

# Mode labels (used both for entry creation and for cleanup of older versions)
LABEL_GAMESCOPE="Arch Linux from RAM (gamescope)"
LABEL_ES="Arch Linux from RAM (EmulationStation)"
LABEL_KIOSK="Arch Linux from RAM (kiosk)"
LABEL_HYPRLAND="Arch Linux from RAM (hyprland)"
LABEL_DEBUG="Arch Linux from RAM (debug TTY)"
LABEL_LEGACY="Arch Linux from RAM"   # old single-entry name, scrubbed if found

# Parse flags
WANT_GAMESCOPE=1
WANT_ES=auto         # 1=force install ES from AUR, 0=skip, auto=enable iff ES is installed
WANT_KIOSK=1
WANT_HYPRLAND=auto   # 1=force, 0=skip, auto=enable iff hyprland is installed
DEFAULT_MODE=gamescope    # which entry to put first (becomes GRUB default)
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-gamescope)         WANT_GAMESCOPE=0; [[ "$DEFAULT_MODE" == "gamescope" ]] && DEFAULT_MODE=kiosk ;;
        --no-emulationstation)  WANT_ES=0 ;;
        --with-emulationstation) WANT_ES=1 ;;
        --no-kiosk)             WANT_KIOSK=0; [[ "$DEFAULT_MODE" == "kiosk" ]] && DEFAULT_MODE=hyprland ;;
        --no-hyprland)          WANT_HYPRLAND=0 ;;
        --with-hyprland)        WANT_HYPRLAND=1 ;;
        --default=*)            DEFAULT_MODE="${1#*=}" ;;
        -h|--help)
            sed -n '2,/^$/p' "$0" | sed 's|^# \?||'
            exit 0
            ;;
        *) echo "Unknown flag: $1"; exit 1 ;;
    esac
    shift
done

if [[ $EUID -ne 0 ]]; then
    echo "Run as root: sudo $0 $*"
    exit 1
fi

# mkinitcpio uses pushd/popd internally — if our CWD is on a path root can't
# traverse (e.g. NFS with root_squash), popd fails and the build aborts.
cd / || exit 1

echo "=== arch2ram-install ==="
echo ""

# ── 1. Dependencies ──────────────────────────────────────────────────────────

echo "[1/6] Checking dependencies..."
NEED=()
pacman -Q mkinitcpio-archiso &>/dev/null || NEED+=(mkinitcpio-archiso)
pacman -Q squashfs-tools     &>/dev/null || NEED+=(squashfs-tools)
# Sprint 1 deps — universal hotkeys via triggerhappy + on-screen feedback
pacman -Q triggerhappy       &>/dev/null || NEED+=(triggerhappy)
pacman -Q xosd               &>/dev/null || NEED+=(xosd)
pacman -Q unclutter          &>/dev/null || NEED+=(unclutter)
pacman -Q xdotool            &>/dev/null || NEED+=(xdotool)
pacman -Q yad                &>/dev/null || NEED+=(yad)
if (( WANT_GAMESCOPE )); then
    pacman -Q gamescope      &>/dev/null || NEED+=(gamescope)
    pacman -Q steam          &>/dev/null || NEED+=(steam)
    pacman -Q mangohud       &>/dev/null || NEED+=(mangohud)
fi
if (( WANT_KIOSK )); then
    pacman -Q cage           &>/dev/null || NEED+=(cage)
    pacman -Q konsole        &>/dev/null || NEED+=(konsole)
fi
if (( ${#NEED[@]} )); then
    echo "      installing: ${NEED[*]}"
    pacman -S --needed --noconfirm "${NEED[@]}"
else
    echo "      OK"
fi

# Sanity: kernel must exist
if [[ ! -f "$KERNEL_IMG" ]]; then
    echo "ERROR: $KERNEL_IMG not found — install the 'linux' package first."
    exit 1
fi

# Decide on hyprland mode availability
HAS_HYPRLAND=0
case "$WANT_HYPRLAND" in
    1)
        if ! pacman -Q hyprland &>/dev/null; then
            echo "      installing hyprland (--with-hyprland)..."
            pacman -S --needed --noconfirm hyprland
        fi
        HAS_HYPRLAND=1
        ;;
    auto)
        pacman -Q hyprland &>/dev/null && HAS_HYPRLAND=1
        ;;
    0) HAS_HYPRLAND=0 ;;
esac

# Decide on EmulationStation mode availability
HAS_ES=0
case "$WANT_ES" in
    1)
        if ! pacman -Q emulationstation &>/dev/null; then
            echo "      installing emulationstation from AUR (--with-emulationstation)..."
            if command -v yay &>/dev/null; then
                # Drop privs to user — yay refuses to run as root
                sudo -u "${SUDO_USER:-$(getent passwd 1000 | cut -d: -f1)}" yay -S --needed --noconfirm --answerdiff=None --answerclean=None --removemake emulationstation
            else
                echo "      WARNING: yay not installed — cannot install ES automatically. Skipping."
                WANT_ES=0
            fi
        fi
        pacman -Q emulationstation &>/dev/null && HAS_ES=1
        ;;
    auto)
        pacman -Q emulationstation &>/dev/null && HAS_ES=1
        ;;
    0) HAS_ES=0 ;;
esac

# ── 2. Install mkinitcpio config + preset ────────────────────────────────────

echo "[2/6] Installing mkinitcpio config + preset..."
install -Dm644 "$CONF_SRC"   "$CONF_DST"
install -Dm644 "$PRESET_SRC" "$PRESET_DST"
echo "      $CONF_DST"
echo "      $PRESET_DST"

# ── 3. Install arch2ramos runtime files (scripts, units, configs) ────────────

echo "[3/6] Installing arch2ramos runtime files..."
# DRM fixup (required for all modes on hybrid-GPU systems)
install -Dm755 "$DRM_FIXUP_SCRIPT_SRC" "$DRM_FIXUP_SCRIPT_DST"
install -Dm644 "$DRM_FIXUP_UNIT_SRC"   "$DRM_FIXUP_UNIT_DST"
install -Dm755 "$DRM_ENVGEN_SRC"       "$DRM_ENVGEN_DST"
systemctl enable arch2ram-drm-fixup.service >/dev/null 2>&1 || true
echo "      drm-fixup: script + service + env generator"

# Universal hotkeys (Sprint 1): triggerhappy + dispatcher + helpers.
# These work across every boot mode (gamescope/ES/cage/hyprland/tty)
# because triggerhappy reads /dev/input/event* at the kernel layer.
install -Dm755 "$TH_RUN_SRC"      "$TH_RUN_DST"
install -Dm755 "$TH_MOUSE_SRC"    "$TH_MOUSE_DST"
install -Dm755 "$TH_SHOT_SRC"     "$TH_SHOT_DST"
install -Dm755 "$TH_HELP_SRC"     "$TH_HELP_DST"
install -Dm755 "$TH_BRIGHT_SRC"   "$TH_BRIGHT_DST"
install -Dm755 "$TH_KILLFG_SRC"   "$TH_KILLFG_DST"
install -Dm644 "$TH_CONF_SRC"     "$TH_CONF_DST"
install -Dm644 "$TH_OVERRIDE_SRC" "$TH_OVERRIDE_DST"
systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable triggerhappy.service >/dev/null 2>&1 || true
echo "      hotkeys: triggerhappy + dispatcher + 6 helper scripts"

# Kiosk lockdown (Sprint 2): block Ctrl+Alt+F1..F12 TTY switching.
# The script self-disables when not in RAM mode, so installing the unit
# globally is safe -- it'll only do work on RAM boots.
install -Dm755 "$DALTFN_SCRIPT_SRC" "$DALTFN_SCRIPT_DST"
install -Dm644 "$DALTFN_UNIT_SRC"   "$DALTFN_UNIT_DST"
systemctl enable arch2ram-disablealtfn.service >/dev/null 2>&1 || true
echo "      kiosk-lockdown: arch2ram-disablealtfn (RAM-mode only)"

# Kiosk (cage)
if (( WANT_KIOSK )); then
    install -Dm755 "$KIOSK_SCRIPT_SRC" "$KIOSK_SCRIPT_DST"
    install -Dm644 "$KIOSK_UNIT_SRC"   "$KIOSK_UNIT_DST"
    install -Dm644 "$KONSOLE_PROFILE_SRC" "$KONSOLE_PROFILE_DST"
    systemctl enable arch2ram-kiosk.service >/dev/null 2>&1 || true
    echo "      kiosk: script + service + konsole profile"
fi

# Hyprland
if (( HAS_HYPRLAND )); then
    install -Dm755 "$HYPRLAND_SCRIPT_SRC" "$HYPRLAND_SCRIPT_DST"
    install -Dm644 "$HYPRLAND_UNIT_SRC"   "$HYPRLAND_UNIT_DST"
    install -Dm644 "$HYPRLAND_CONF_SRC"   "$HYPRLAND_CONF_DST"
    systemctl enable arch2ram-hyprland.service >/dev/null 2>&1 || true
    echo "      hyprland: script + service + config wrapper"
else
    echo "      hyprland: skipped (not installed or disabled by flag)"
fi

# Gamescope (gamescope + Steam Big Picture launcher)
if (( WANT_GAMESCOPE )); then
    install -Dm755 "$GAMESCOPE_SCRIPT_SRC" "$GAMESCOPE_SCRIPT_DST"
    install -Dm644 "$GAMESCOPE_UNIT_SRC"   "$GAMESCOPE_UNIT_DST"
    systemctl enable arch2ram-gamescope.service >/dev/null 2>&1 || true
    echo "      gamescope: script + service (Steam Big Picture launcher)"
fi

# EmulationStation (gamescope + ES launcher with category-based systems)
if (( HAS_ES )); then
    install -Dm755 "$ES_SCRIPT_SRC"         "$ES_SCRIPT_DST"
    install -Dm755 "$ES_DISCOVER_SRC"       "$ES_DISCOVER_DST"
    install -Dm755 "$ES_LAUNCH_SRC"         "$ES_LAUNCH_DST"
    install -Dm755 "$ES_BOOKMARKS_SRC"      "$ES_BOOKMARKS_DST"
    install -Dm755 "$ES_MUSIC_SRC"          "$ES_MUSIC_DST"
    install -Dm755 "$ES_DISCOVER_ALL_SRC"   "$ES_DISCOVER_ALL_DST"
    install -Dm755 "$ES_NEWS_SRC"           "$ES_NEWS_DST"
    install -Dm755 "$ES_THEME_GEN_SRC"      "$ES_THEME_GEN_DST"
    install -Dm644 "$ES_UNIT_SRC"           "$ES_UNIT_DST"
    install -Dm644 "$ES_CONF_SRC"           "$ES_CONF_DST"
    # Generate per-category icons for the Carbon theme
    "$ES_THEME_GEN_DST" 2>/dev/null || true
    systemctl enable arch2ram-emulationstation.service >/dev/null 2>&1 || true
    echo "      emulationstation: 6 scripts + service + es_systems.cfg"

    # Run the full discovery orchestrator — populates ~/ES/ from many
    # sources (apps, bookmarks, music, linux/windows games, Steam,
    # SSH config). Idempotent — safe to re-run.
    user="${SUDO_USER:-$(getent passwd 1000 | cut -d: -f1)}"
    home="$(getent passwd "$user" | cut -d: -f6)"
    echo "      emulationstation: running auto-discovery (populates $home/ES/)..."
    sudo -u "$user" "$ES_DISCOVER_ALL_DST" || \
        echo "      WARNING: discovery had errors — re-run manually: arch2ram-discover-all"
else
    echo "      emulationstation: skipped (not installed)"
fi

# arch2ram-update (used from disk-mode for the refresh cycle) +
# arch2ram-create (so it's on PATH for arch2ram-update to find)
install -Dm755 "$UPDATE_SCRIPT_SRC" "$UPDATE_SCRIPT_DST"
install -Dm755 "$CREATE_SCRIPT_SRC" "$CREATE_SCRIPT_DST"
echo "      arch2ram-update + arch2ram-create installed to /usr/local/bin/"

# ── 4. Build initramfs ───────────────────────────────────────────────────────

echo "[4/6] Building initramfs (this takes ~30s)..."
mkinitcpio -p arch2ram
echo "      → $INITRAMFS ($(du -sh "$INITRAMFS" | cut -f1))"

# ── 5. Determine boot params and write GRUB entries ──────────────────────────

ROOT_UUID="$(findmnt -n -o UUID /)"
BOOT_SRC="$(findmnt -n -o SOURCE /boot 2>/dev/null || findmnt -n -o SOURCE /)"
BOOT_UUID="$(blkid -s UUID -o value "$BOOT_SRC")"

# If /boot is its own mount point, kernel/initrd paths are relative to its root.
# Otherwise (/boot is a directory in /), prefix with /boot.
if mountpoint -q /boot; then
    KERNEL_PATH="/vmlinuz-linux"
    INITRD_PATH="/initramfs-arch2ram.img"
    INTEL_UCODE="/intel-ucode.img"
    AMD_UCODE="/amd-ucode.img"
else
    KERNEL_PATH="/boot/vmlinuz-linux"
    INITRD_PATH="/boot/initramfs-arch2ram.img"
    INTEL_UCODE="/boot/intel-ucode.img"
    AMD_UCODE="/boot/amd-ucode.img"
fi

# Microcode: include whichever ucode files are present (mirrors normal Arch boot).
UCODE_LINES=""
[[ -f "/boot/intel-ucode.img" ]] && UCODE_LINES+="    initrd ${INTEL_UCODE}"$'\n'
[[ -f "/boot/amd-ucode.img"   ]] && UCODE_LINES+="    initrd ${AMD_UCODE}"$'\n'

# Inherit hardware-specific tunings from the user's existing kernel cmdline.
# Drop params that archiso owns (root=, rootfstype=, resume= — no swap in RAM
# mode; rw — overlay is rw by default).
EXTRA_CMDLINE=""
SRC_CMDLINE=""
if [[ -f /etc/kernel/cmdline ]]; then
    SRC_CMDLINE="$(cat /etc/kernel/cmdline)"
elif [[ -f /etc/default/grub ]]; then
    # shellcheck disable=SC1091
    SRC_CMDLINE="$(. /etc/default/grub; echo "$GRUB_CMDLINE_LINUX $GRUB_CMDLINE_LINUX_DEFAULT")"
fi
if [[ -n "$SRC_CMDLINE" ]]; then
    for tok in $SRC_CMDLINE; do
        case "$tok" in
            root=*|rootfstype=*|resume=*|rw|ro|rootflags=*) ;;
            *) EXTRA_CMDLINE+="${EXTRA_CMDLINE:+ }$tok" ;;
        esac
    done
fi

# Emit a single GRUB menuentry. Args: label, mode-specific kernel args.
emit_entry() {
    local label="$1"
    local mode_args="$2"
    cat <<GRUBEOF

menuentry "${label}" --class arch --class gnu-linux --class os {
    insmod part_gpt
    insmod fat
    insmod ext2
    search --no-floppy --fs-uuid --set=root ${BOOT_UUID}
    linux  ${KERNEL_PATH} archisobasedir=var/lib/arch2ram archisosearchuuid=${ROOT_UUID} copytoram=y cow_spacesize=2G${EXTRA_CMDLINE:+ }${EXTRA_CMDLINE}${mode_args:+ }${mode_args}
${UCODE_LINES}    initrd ${INITRD_PATH}
}
GRUBEOF
}

# Build the entries — emit DEFAULT_MODE first so it lands at GRUB index 0
NEW_ENTRIES=""
LABELS_TO_REPLACE=("$LABEL_LEGACY" "$LABEL_DEBUG")

emit_mode() {
    local mode="$1"
    case "$mode" in
        gamescope)
            (( WANT_GAMESCOPE )) || return 0
            NEW_ENTRIES+="$(emit_entry "$LABEL_GAMESCOPE" "systemd.unit=multi-user.target arch2ram.mode=gamescope")"$'\n'
            LABELS_TO_REPLACE+=("$LABEL_GAMESCOPE")
            ;;
        es|emulationstation)
            (( HAS_ES )) || return 0
            NEW_ENTRIES+="$(emit_entry "$LABEL_ES" "systemd.unit=multi-user.target arch2ram.mode=emulationstation")"$'\n'
            LABELS_TO_REPLACE+=("$LABEL_ES")
            ;;
        kiosk)
            (( WANT_KIOSK )) || return 0
            NEW_ENTRIES+="$(emit_entry "$LABEL_KIOSK" "systemd.unit=multi-user.target arch2ram.mode=kiosk")"$'\n'
            LABELS_TO_REPLACE+=("$LABEL_KIOSK")
            ;;
        hyprland)
            (( HAS_HYPRLAND )) || return 0
            NEW_ENTRIES+="$(emit_entry "$LABEL_HYPRLAND" "systemd.unit=multi-user.target arch2ram.mode=hyprland")"$'\n'
            LABELS_TO_REPLACE+=("$LABEL_HYPRLAND")
            ;;
    esac
}

# Default mode first (becomes GRUB index 0), then the rest in canonical order.
emit_mode "$DEFAULT_MODE"
for m in gamescope es kiosk hyprland; do
    [[ "$m" == "$DEFAULT_MODE" ]] && continue
    [[ "es" == "$DEFAULT_MODE" && "$m" == "es" ]] && continue
    emit_mode "$m"
done
NEW_ENTRIES+="$(emit_entry "$LABEL_DEBUG" "systemd.unit=multi-user.target")"$'\n'

echo "[5/6] Writing GRUB entries to $GRUB_CUSTOM..."
echo "      boot UUID:    $BOOT_UUID  (source: $BOOT_SRC)"
echo "      root UUID:    $ROOT_UUID"
echo "      kernel path:  $KERNEL_PATH"
echo "      modes:        gamescope=$WANT_GAMESCOPE es=$HAS_ES kiosk=$WANT_KIOSK hyprland=$HAS_HYPRLAND debug=1"
echo "      default:      $DEFAULT_MODE"

# Rewrite custom file: keep header + entries with labels not in our managed set,
# then append our entries.
python3 - "$GRUB_CUSTOM" "$NEW_ENTRIES" "${LABELS_TO_REPLACE[@]}" <<'PYEOF'
import sys, re, os
path = sys.argv[1]
new_entries = sys.argv[2]
skip_labels = sys.argv[3:]
try:
    content = open(path).read()
except FileNotFoundError:
    content = "#!/bin/sh\nexec tail -n +3 $0\n# Custom GRUB entries — managed by arch2ram-install\n"
parts = re.split(r'(?=^menuentry )', content, flags=re.MULTILINE)
header = parts[0]
def keep(p):
    return not any(f'"{label}"' in p.split('\n', 1)[0] for label in skip_labels)
entries = [p for p in parts[1:] if keep(p)]
result = header + "".join(entries) + new_entries
open(path, 'w').write(result)
os.chmod(path, 0o755)
PYEOF

# ── 6. Regenerate grub.cfg ───────────────────────────────────────────────────

echo "[6/6] Regenerating GRUB config..."
if grub-mkconfig -o /boot/grub/grub.cfg 2>&1 | tee /tmp/arch2ram-grub.log | grep -qE "^(Found|Done|Generating)"; then
    echo "      OK"
else
    echo "      WARNING: grub-mkconfig may have failed (e.g. if running from RAM mode,"
    echo "      overlayfs root prevents canonical path resolution). Re-run from disk mode."
fi

echo ""
echo "=== Done ==="
echo ""
echo "Boot modes installed:"
(( WANT_GAMESCOPE )) && echo "  • $LABEL_GAMESCOPE (gamescope + Steam Big Picture)"
(( HAS_ES ))         && echo "  • $LABEL_ES (gamescope + EmulationStation)"
(( WANT_KIOSK ))     && echo "  • $LABEL_KIOSK   (cage, single fullscreen app)"
(( HAS_HYPRLAND ))   && echo "  • $LABEL_HYPRLAND (multi-window desktop)"
echo "  • $LABEL_DEBUG (tty only, ssh/diagnostics)"
echo ""
echo "  Default (GRUB index 0): $DEFAULT_MODE mode"
echo ""
echo "Next: sudo arch2ram-create     (build the squashfs, ~5 min)"
echo "Then: reboot → select a mode in GRUB"
echo ""
echo "Update cycle:  reboot to disk → sudo arch2ram-update → reboot back"
echo ""
echo "Note: if GRUB_TIMEOUT in /etc/default/grub is too short (<5s)"
echo "you may not have time to select an entry — bump it before rebooting."
