#!/usr/bin/env python3
"""arch2ram-catalog-seed -- generate ~/ES/catalog/<Category>/<Name>.sh entries
from a structured curated list. Each .sh calls arch2ram-catalog install
with the right package name, optionally specifying the binary to launch.

Re-runnable: existing files are overwritten (so updating the seed updates
the catalog).
"""
