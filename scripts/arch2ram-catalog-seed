ENTRY_TEMPLATE = """#!/bin/bash
# arch2ramos catalog entry
# Generated by arch2ram-catalog-seed -- edit the seed script instead.
#
# name: {name}
# pkg:  {pkg}
# desc: {desc}
exec arch2ram-catalog launch-if-installed "{pkg}" "{binary}"
"""

def main():
    CATALOG.mkdir(parents=True, exist_ok=True)

    # Top-level README
    readme = CATALOG / "_README.txt"
    readme.write_text(
        "arch2ramos catalog -- curated software\n"
        "\n"
        "Click any category folder, then any app to install or launch it.\n"
        "Already-installed apps launch directly. Otherwise, a konsole\n"
        "window opens with yay/pacman and asks for confirmation.\n"
        "\n"
        "To uninstall:\n"
        "  /usr/local/bin/arch2ram-catalog uninstall <pkg>\n"
    )

    total = 0
    for category, entries in CATALOG_DATA.items():
        catdir = CATALOG / category
        catdir.mkdir(exist_ok=True)
        for name, pkg, binary, desc in entries:
            safe_name = name.replace("/", "_").replace(" ", "_")
            entry_file = catdir / f"{safe_name}.sh"
            entry_file.write_text(ENTRY_TEMPLATE.format(
                name=name, pkg=pkg, binary=binary, desc=desc
            ))
            entry_file.chmod(entry_file.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
            total += 1

    print(f"Wrote {total} catalog entries in {len(CATALOG_DATA)} categories under {CATALOG}/")
    for category in sorted(CATALOG_DATA):
        print(f"  {category:18s} ({len(CATALOG_DATA[category])} entries)")

if __name__ == "__main__":
    main()
